diff --git a/usermode-probe/tests/device_selection_selftest.cpp b/usermode-probe/tests/device_selection_selftest.cpp
new file mode 100644
index 0000000..07d318b
--- /dev/null
+++ b/usermode-probe/tests/device_selection_selftest.cpp
@@ -0,0 +1,76 @@
+#include "device_selection.h"
+
+#include <iostream>
+#include <utility>
+
+static NcmInterfaceCandidate Candidate(bool control, const std::wstring& serial = L"MAC_A")
+{
+    return {
+        control ? L"control-path" : L"data-path",
+        std::wstring(L"USB\\VID_05AC&PID_1905&MI_") + (control ? L"00" : L"01") + L"\\CHILD",
+        L"USB\\VID_05AC&PID_1905\\" + serial,
+    };
+}
+
+static void Check(bool condition, const char* message)
+{
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+template <typename F>
+static void Reject(F test, const char* message)
+{
+    bool rejected = false;
+    try {
+        test();
+    }
+    catch (const std::runtime_error&) {
+        rejected = true;
+    }
+    Check(rejected, message);
+}
+
+int main()
+{
+    const auto control = Candidate(true);
+    const auto data = Candidate(false);
+    auto pair = SelectTargetNcmPair({control}, {data});
+    Check(pair.control.path == L"control-path" && pair.data.path == L"data-path", "valid pair failed");
+
+    auto lowercase = data;
+    lowercase.instanceId = L"usb\\vid_05ac&pid_1905&mi_01\\child";
+    lowercase.parentInstanceId = L"usb\\vid_05ac&pid_1905\\mac_a";
+    SelectTargetNcmPair({control}, {lowercase});
+
+    auto otherPid = control;
+    otherPid.instanceId = L"USB\\VID_05AC&PID_1902&MI_00\\CHILD";
+    otherPid.path = L"wrong-first-path";
+    pair = SelectTargetNcmPair({otherPid, control}, {data});
+    Check(pair.control.path == control.path, "foreign PID was selected");
+    Reject([&] { SelectTargetNcmPair({otherPid}, {data}); }, "foreign PID accepted");
+    Reject([&] { SelectTargetNcmPair({control}, {Candidate(false, L"MAC_B")}); }, "mixed parents accepted");
+    Reject([&] { SelectTargetNcmPair({control, Candidate(true, L"MAC_B")}, {data}); }, "partial second Mac ignored");
+    Reject([&] { SelectTargetNcmPair({control, control}, {data}); }, "duplicate control paths accepted");
+    Reject([&] { SelectTargetNcmPair({control}, {data, data}); }, "duplicate data paths accepted");
+    Reject([&] { SelectTargetNcmPair({}, {}); }, "empty enumeration accepted");
+    Reject([&] { SelectTargetNcmPair({control}, {}); }, "missing data accepted");
+    Reject([&] { SelectTargetNcmPair({data}, {control}); }, "wrong MI roles accepted");
+
+    auto spoof = control;
+    spoof.instanceId = L"USB\\VID_05AC&PID_1905&MI_000\\CHILD";
+    Reject([&] { SelectTargetNcmPair({spoof}, {data}); }, "interface prefix collision accepted");
+    spoof = control;
+    spoof.parentInstanceId = L"USB\\VID_05AC&PID_1905&MI_00\\MAC_A";
+    Reject([&] { SelectTargetNcmPair({spoof}, {data}); }, "non-composite parent accepted");
+    spoof = control;
+    spoof.parentInstanceId = L"USB\\VID_05AC&PID_1905\\";
+    Reject([&] { SelectTargetNcmPair({spoof}, {data}); }, "empty parent instance accepted");
+    spoof = control;
+    spoof.path.clear();
+    Reject([&] { SelectTargetNcmPair({spoof}, {data}); }, "empty device path accepted");
+
+    std::cout << "device selection self-test passed\n";
+    return 0;
+}
