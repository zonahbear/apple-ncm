diff --git a/usermode-probe/device_selection.h b/usermode-probe/device_selection.h
new file mode 100644
index 0000000..d5a7fb8
--- /dev/null
+++ b/usermode-probe/device_selection.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+// PnP metadata, rather than symbolic-link ordering, establishes physical identity.
+struct NcmInterfaceCandidate {
+    std::wstring path;
+    std::wstring instanceId;
+    std::wstring parentInstanceId;
+};
+
+struct NcmInterfacePair {
+    NcmInterfaceCandidate control;
+    NcmInterfaceCandidate data;
+};
+
+inline std::wstring CanonicalUsbId(std::wstring value)
+{
+    for (auto& ch : value) {
+        if (ch >= L'a' && ch <= L'z') {
+            ch = static_cast<wchar_t>(ch - L'a' + L'A');
+        }
+    }
+    return value;
+}
+
+inline bool HasUsbInstancePrefix(const std::wstring& instanceId, const std::wstring& prefix)
+{
+    const auto canonical = CanonicalUsbId(instanceId);
+    return canonical.size() > prefix.size() && canonical.compare(0, prefix.size(), prefix) == 0;
+}
+
+inline bool IsTargetNcmInterface(const NcmInterfaceCandidate& candidate, bool control)
+{
+    return !candidate.path.empty() &&
+        HasUsbInstancePrefix(candidate.instanceId, control ?
+            L"USB\\VID_05AC&PID_1905&MI_00\\" : L"USB\\VID_05AC&PID_1905&MI_01\\") &&
+        HasUsbInstancePrefix(candidate.parentInstanceId, L"USB\\VID_05AC&PID_1905\\");
+}
+
+inline NcmInterfacePair SelectTargetNcmPair(
+    const std::vector<NcmInterfaceCandidate>& controls,
+    const std::vector<NcmInterfaceCandidate>& data)
+{
+    std::vector<NcmInterfaceCandidate> matchingControls;
+    std::vector<NcmInterfaceCandidate> matchingData;
+    std::set<std::wstring> parents;
+    for (const auto& candidate : controls) {
+        if (IsTargetNcmInterface(candidate, true)) {
+            matchingControls.push_back(candidate);
+            parents.insert(CanonicalUsbId(candidate.parentInstanceId));
+        }
+    }
+    for (const auto& candidate : data) {
+        if (IsTargetNcmInterface(candidate, false)) {
+            matchingData.push_back(candidate);
+            parents.insert(CanonicalUsbId(candidate.parentInstanceId));
+        }
+    }
+    if (parents.size() > 1) {
+        throw std::runtime_error(
+            "Multiple Apple 05AC:1905 USB instances found; control/data must share one composite parent. "
+            "Disconnect the other Macs and retry.");
+    }
+    if (matchingControls.empty() || matchingData.empty()) {
+        throw std::runtime_error(
+            "No complete Apple 05AC:1905 WinUSB pair found. Install WinUSB on MI_00 (control) "
+            "and MI_01 (data), leaving the composite parent on usbccgp, then reconnect both cable ends.");
+    }
+    if (matchingControls.size() != 1 || matchingData.size() != 1) {
+        throw std::runtime_error("Ambiguous Apple 05AC:1905 interface paths; refusing to choose the first path.");
+    }
+    return { matchingControls.front(), matchingData.front() };
+}
